# Copy to backend/.env for local development. backend/.env is git-ignored.
# Never commit real values. Rotate anything that has ever appeared in a public commit.

# --- Required to boot -------------------------------------------------------
# Session-signing key. The app refuses to start without it.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ISSUER=pacio
ACCESS_TOKEN_DAYS=7

# --- Runtime profile --------------------------------------------------------
# "production" (or any Vercel deployment) refuses to start without MONGO_URL.
APP_ENV=development
# Shared-store rate limiting for login, reset, registration and invitations.
RATE_LIMIT_ENABLED=true

# --- Data -------------------------------------------------------------------
# Without MONGO_URL the app runs on the in-memory fallback and loses all data
# on every cold start. Never use that for real institutions.
MONGO_URL=
DB_NAME=careeros
DEFAULT_INSTITUTION_ID=inst_kmit

# --- Deployment identity ----------------------------------------------------
# Comma-separated list of origins allowed to send credentialed cross-origin calls.
ALLOWED_ORIGINS=https://your-app.vercel.app
# Canonical public origin used for password-reset and invitation links.
PUBLIC_BASE_URL=https://your-app.vercel.app
COOKIE_SECURE=

# --- Sign-in ----------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PASSWORD_AUTH_ENABLED=true
# Legacy Emergent-platform login. Leave false unless you specifically need it.
EMERGENT_AUTH_ENABLED=false
EMERGENT_AUTH_URL=

# --- Bootstrap admin --------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Demo data (local/judging only) ----------------------------------------
SEED_DEMO_DATA=true
SEED_DEMO_USERS=false
DEFAULT_DEMO_PASSWORD=

# --- Notifications ----------------------------------------------------------
SENDGRID_API_KEY=
SENDER_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional integrations --------------------------------------------------
JOOBLE_API_KEY=
EMERGENT_LLM_KEY=

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.doc,.docx,.png,.jpg,.jpeg
